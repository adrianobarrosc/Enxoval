{
  "rules": {
    ".read": false,
    ".write": false,
    "enxovais": {
      "$pagina": {
        ".read": "$pagina.length >= 6 && $pagina.length <= 40",
        ".write": "$pagina.length >= 6 && $pagina.length <= 40",
        "marcados": {
          "$item": {
            ".validate": "newData.isBoolean() && newData.val() === true && $item.length <= 80"
          }
        },
        "estacao": {
          ".validate": "newData.isString() && newData.val().matches(/^(v|m|i)$/)"
        },
        "atualizadoEm": {
          ".validate": "newData.val() === now"
        },
        "$outro": { ".validate": false }
      }
    }
  }
}
